{
    "img": "img/floorplans/cc-plan-0.svg",
    "canvasElements": [
        {
            "#COMMENT": "----===== Window Status Indication Image (Terassentür) =====----", 
            "type": "image",
            "class": "windowClosed",
            "style":
            {
                "right": "-0.5vmin",
                "top": "60%"
            },
            "conditions": [
                {
                    "binding": "window/terrace.status",
                    "bindingProvider": "smarthome",
                    "value": true,
                    "class": "windowOpen"
                },
                {
                    "binding": "window/terrace.status",
                    "bindingProvider": "smarthome",
                    "value": false,
                    "class": "windowClosed"
                }
            ]
        },
        {
            "#COMMENT": "----===== Window Status Indication Image (Küchenfenster) =====----", 
            "type": "image",
            "class": "windowClosed",
            "style":
            {
                "left": "-0.5vmin",
                "top": "60%"
            },
            "conditions": [
                {
                    "binding": "window/kitchen.status",
                    "bindingProvider": "smarthome",
                    "value": true,
                    "class": "windowOpen"
                },
                {
                    "binding": "window/kitchen.status",
                    "bindingProvider": "smarthome",
                    "value": false,
                    "class": "windowClosed"
                }
            ]
        },
        {
            "#COMMENT": "----===== Door Status Indication Image (Eingangstür) =====----", 
            "type": "image",
            "class": "windowClosed",
            "style":
            {
                "left": "-0.5vmin",
                "top": "33.5%",
                "height": "13%"
            },
            "conditions": [
                {
                    "binding": "window/entrance.status",
                    "bindingProvider": "smarthome",
                    "value": true,
                    "class": "windowOpen"
                },
                {
                    "binding": "window/entrance.status",
                    "bindingProvider": "smarthome",
                    "value": false,
                    "class": "windowClosed"
                }
            ]
        },
        {
            "#COMMENT": "----===== Button Group with Light Controls (Wohnzimmer) =====----", 
            "type": "buttongroup",
            "title": "Wohnzimmer",
            "left": "60%",   
            "top": "40%",
            "controls": [
                {
                    "type": "switch",
                    "id": "switch-wohnzimmer",
                    "binding": "group/living",
                    "bindingProvider": "smarthome",
                    "img": "img/icons/2.0/power.png",
                    "style": {
                        "content": "background-size: 70%;"
                    },
                    "action": {
                        "adapter": "smarthome",
                        "method": "trigger",
                        "payload": {
                            "deviceId": "group/living"
                        },
                        "sound": "KEY1"
                    }
                },
                {
                    "type": "select",
                    "img": "img/icons/2.0/relax.png",
                    "style": {
                        "content": "background-size: 65%;"
                    },
                    "action": {
                        "adapter": "smarthome",
                        "method": "scene",
                        "payload": {
                            "deviceId": "group/living",
                            "sceneId": 10
                        },
                        "sound": "SCENE"
                    }
                },
                {
                    "type": "select",
                    "img": "img/icons/2.0/movie.png",
                    "style": {
                        "content": "background-size: 50%;"
                    },                    
                    "action": {
                        "adapter": "smarthome",
                        "method": "scene",
                        "payload": {
                            "deviceId": "group/living",
                            "sceneId": 12
                        },
                        "sound": "SCENE"
                    }
                },
                {
                    "type": "select",
                    "img": "img/icons/2.0/bright.png",
                    "style": {
                        "content": "background-size: 50%;"
                    },                
                    "action": {
                        "adapter": "smarthome",
                        "method": "scene",
                        "payload": {
                            "deviceId": "group/living",
                            "sceneId": 11
                        },
                        "sound": "SCENE"
                    }
                }
            ],
            "footer": 
            [
                {
                    "id": "room_living.humidity",
                    "binding": "climate/living.humidity",
                    "bindingProvider": "smarthome",
                    "decimals": 1,
                    "suffix": "%",
                    "align": "left"
                },
                {
                    "#COMMENT": "----===== Battery Info =====----", 
                    "__external": "_snippets/canvas/battery-footer-item",
                    "__externalArgs": {
                        "target": "living"
                    } 
                },
                {
                    "id": "room_living.temp",
                    "binding": "climate/living.temperature",
                    "bindingProvider": "smarthome",
                    "decimals": 1,
                    "suffix": "°",
                    "align": "right"
                }
            ]
        },
        {
            "#COMMENT": "----===== Button Group with Power Info =====----", 
            "type": "buttongroup",
            "title": "Strom",
            "smallFooter": true,
            "style": {
                "left": "25%",
                "top": "5%",
                "content": {
                    "style": "font-size: 10em;"

                }
            },
            "controls": [
                {
                    "id": "powerHeating",
                    "type": "navigate",
                    "style": {
                        "img": "img/icons/switch_house_heating_power.png",
                        "content": "background-size: 55%;"
                    },
                    "view": {
                        "__external": "_windows/powerlog",
                        "__externalArgs": { 
                            "deviceId": "power/heating",
                            "variant": "day",
                            "windowId": "powerHeating",
                            "titleExt": "Wärmepumpenstrom"
                        },
                        "target": "window"
                    }
                },
                {
                    "id": "powerHome",
                    "type": "navigate",
                    "style": {
                        "img": "img/icons/switch_house_power2.png",
                        "content": "background-size: 55%;"
                    },
                    "view": {
                        "__external": "_windows/powerlog",
                        "__externalArgs": { 
                            "deviceId": "power/home",
                            "variant": "day",
                            "windowId": "powerHome",
                            "titleExt": "Haushaltsstrom"
                        },
                        "target": "window"
                    }
                }
            ],
            "footer": 
            [
                {
                    "id": "powerHeating.value",
                    "binding": "power/heating",
                    "bindingProvider": "smarthome",
                    "decimals": 0,
                    "suffix": "",
                    "align": "left"
                },
                {
                    "id": "powerHome.value",
                    "binding": "power/home",
                    "bindingProvider": "smarthome",
                    "decimals": 0,
                    "suffix": "",
                    "align": "right"
                }
            ]
        },
